#!/usr/bin/env node
// Runs ESLint and prints diagnostics in the shape BE-Code's msvc parser
// reads: path(line,col): error ESL001: RULE: message
//
// Why a wrapper at all: ESLint's default "stylish" format puts the filename
// on a header line, which no line-based parser can read, and the two formats
// that could be parsed (unix, compact) have been removed from core ESLint —
// verified absent in 9.39.5 and 10.12.0 alike. Doing the conversion here
// keeps ESLint's format churn inside the pack, where a pack author can fix
// it, rather than inside the harness, where it would need a release.
//
// Why the constant ESL001 rather than the rule name as the code: the parser's
// code group is `[A-Z]{1,3}\d{3,5}` (internal/verify/ubt.go, reMSVC), which
// `TS18048` satisfies and `jsx-a11y/alt-text` cannot. The first version of
// this wrapper put the rule name there, every line failed to parse, and a
// failing lint check reached the model as "exit code 1 and no recognisable
// error line" — no diagnosis, no signature, and no playbook entry, found only
// by running the real harness against the real pack.
//
// The rule name therefore leads the message instead, where playbook entries
// still match it: a match is tried against the raw line as well as the
// message. The code is constant across rules, and the anti-loop signature
// stays distinct because it also covers the normalised message.

import { existsSync, realpathSync } from "node:fs";
import { spawnSync } from "node:child_process";
import { relative, join, sep } from "node:path";

const args = process.argv.slice(2);
let project = process.cwd();
for (let i = 0; i < args.length; i++) {
  if (args[i] === "--project" && args[i + 1]) project = args[++i];
}
// ESLint reports realpaths, so a workspace reached through a symlink —
// /home/me/work -> /mnt/data/work, or macOS's own symlinked temp dir — made
// `relative` produce ../real/src/x.tsx: a path outside the workspace the
// harness confines file reads to, naming a file the model cannot open.
try {
  project = realpathSync(project);
} catch {
  /* a path that cannot be resolved is used as given */
}

const CONFIGS = [
  "eslint.config.js",
  "eslint.config.mjs",
  "eslint.config.cjs",
  "eslint.config.ts",
  ".eslintrc",
  ".eslintrc.js",
  ".eslintrc.json",
  ".eslintrc.cjs",
];
if (!CONFIGS.some((c) => existsSync(join(project, c)))) {
  console.log("no eslint config in this project; lint check skipped");
  process.exit(0);
}

// The project's own ESLint, never a fetched one: npx reaches for the network
// when the dependency is missing, and in an offline-first harness that is
// either a hang or someone else's package executing on every verify run. A
// project that has a config but no installed ESLint is broken in a way this
// check cannot fix, so it is inert and says so.
//
// The package's entry point rather than node_modules/.bin/eslint, because
// .bin holds a shell script on Unix and a .cmd shim on Windows, and spawn can
// execute neither there. One code path, both platforms, no shell.
const local = join(project, "node_modules", "eslint", "bin", "eslint.js");
if (!existsSync(local)) {
  console.log("eslint is not installed in this project; lint check skipped");
  process.exit(0);
}

// "." rather than "src": the flat config's own `files` globs decide what gets
// linted. Passing a path meant any project keeping sources elsewhere — app/
// in Next.js and Remix, anywhere in a monorepo package — failed with "No
// files matching the pattern src were found" and exit 2, a failing check with
// no diagnosis the repair loop could use.
const res = spawnSync(process.execPath, [local, ".", "--format", "json"], {
  cwd: project,
  encoding: "utf8",
  shell: false,
});

let results;
try {
  results = JSON.parse(res.stdout);
} catch {
  // ESLint could not run — a bad config, a missing plugin, or a node that
  // could not be spawned at all. Pass its own complaint through untouched
  // rather than inventing diagnostics, and name a spawn failure explicitly:
  // "no output" hid the commonest cause, which is the tool not being there.
  const why = res.error
    ? `could not run eslint: ${res.error.message}\n`
    : res.stderr || res.stdout || "eslint produced no output\n";
  process.stderr.write(why);
  process.exit(res.status === 0 ? 1 : (res.status ?? 1));
}

let errors = 0;
for (const file of results) {
  const rel = relative(project, file.filePath).split(sep).join("/");
  for (const m of file.messages) {
    if (m.severity !== 2) continue; // warnings must not fail the check
    errors++;
    const code = m.ruleId ?? "eslint";
    console.log(`${rel}(${m.line ?? 1},${m.column ?? 1}): error ESL001: ${code}: ${m.message}`);
  }
}
process.exit(errors > 0 ? 1 : 0);
